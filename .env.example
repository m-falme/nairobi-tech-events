# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=events
POSTGRES_PASSWORD=change-me
POSTGRES_DB=events
DATABASE_URL=postgresql://events:change-me@localhost:5432/events
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-admin-password

# Public base URL used for Open Graph / canonical links
SITE_URL=http://localhost:3000

# Auth.js session secret (required). Generate one: openssl rand -base64 32
AUTH_SECRET=
# Trust the Host header (needed when self-hosting, e.g. Docker; not on Vercel)
AUTH_TRUST_HOST=true

# Importer User-Agent (optional; defaults to NairobiTechEventsBot/1.0 (+https://github.com/m-falme/nairobi-tech-events))
IMPORT_USER_AGENT=

# Set true in production behind Vercel or a single reverse proxy so rate
# limits (login + submissions) use the rightmost X-Forwarded-For hop.
# Leave unset/false for local `next start` / Docker without a proxy: XFF is
# ignored and every request shares the "direct" bucket (spoof-proof).
TRUSTED_PROXY=
